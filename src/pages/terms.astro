---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Terms and Conditions | Suslify"
  description="Suslify's Terms and Conditions — the rules governing your use of the Suslify platform."
>
  <Header />

  <section class="bg-white pt-20 pb-10 md:pt-28 border-b border-slate-100">
    <div class="max-w-4xl mx-auto px-5">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-slate-900 mb-3 leading-tight">
        Terms and Conditions
      </h1>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-5 py-20 text-center">
    <p class="text-slate-500 text-lg">Our Terms and Conditions are currently being reviewed and will be published here shortly.</p>
    <p class="text-slate-400 text-sm mt-3">In the meantime, please contact us at <a href="mailto:hello@suslify.com" class="text-brand-600 hover:underline">hello@suslify.com</a> with any questions.</p>
  </div>

  <Footer />
</BaseLayout>

