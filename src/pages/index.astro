---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const extras = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>`,
    title: 'Community feed',
    desc: 'Announcements, events, and fundraisers from the non-profits you follow.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`,
    title: 'Full donation tracking',
    desc: 'Follow every donation from listing to confirmed handoff, with a clear status at each stage.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/></svg>`,
    title: 'Free for everyone',
    desc: 'No fees, no credit card, for donors and non-profits alike.',
  },
];
---

<BaseLayout>
  <Header />

  <!-- ── HERO ── -->
  <section class="relative overflow-hidden bg-white pt-12 pb-12 md:pt-16 md:pb-20" id="top">
    <!-- background glow -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full bg-brand-100/60 blur-3xl"></div>
      <div class="absolute top-1/2 -left-48 w-[400px] h-[400px] rounded-full bg-brand-50 blur-3xl"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-5">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

        <!-- Copy -->
        <div>
          <p class="flex items-center gap-2 text-brand-600 text-xs font-semibold mb-6 uppercase tracking-wide">
            <span class="w-1.5 h-1.5 bg-brand-500 rounded-full animate-pulse shrink-0"></span>
            Beta launch. Sign up for early access
          </p>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.06] text-slate-900 mb-6">
            Give smarter.<br />
            <span class="text-brand-500">Waste less.</span>
          </h1>

          <p class="text-lg text-slate-500 leading-relaxed max-w-lg mb-8">
            Suslify connects donors with non-profits. Post an item, request what
            you need, message donors directly, and track every donation. All in
            one free app.
          </p>

          <div class="flex flex-wrap gap-3 mb-10">
            <a
              href="#beta"
              class="bg-brand-500 hover:bg-brand-600 text-white font-semibold px-7 py-3.5 rounded-full transition-all shadow-lg shadow-brand-500/25 hover:-translate-y-0.5 active:translate-y-0 text-base"
            >
              Sign Up for Beta. It's Free
            </a>
            <a
              href="#where-you-fit"
              class="border border-slate-200 hover:border-slate-300 bg-white text-slate-700 hover:text-slate-900 font-semibold px-7 py-3.5 rounded-full transition-all text-base hover:shadow-md"
            >
              Explore Suslify
            </a>
          </div>

          <!-- Trust signals -->
          <div class="flex flex-wrap gap-5">
            {[
              'Free for donors and non-profits',
              'No fees, ever',
              'Coordinate without sharing your number',
            ].map((label) => (
              <span class="flex items-center gap-1.5 text-sm text-slate-500 font-medium">
                <svg class="w-4 h-4 text-brand-500 shrink-0" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="8" cy="8" r="8" fill="currentColor" fill-opacity=".15"/>
                  <path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {label}
              </span>
            ))}
          </div>
        </div>

        <!-- Phone mockup -->
        <div class="relative flex justify-center lg:justify-end">
          <div class="relative">
            <!-- glow behind phone -->
            <div class="absolute inset-0 scale-110 rounded-[3rem] bg-brand-300/25 blur-3xl"></div>
            <!-- phone frame -->
            <div class="relative w-64 sm:w-72 bg-slate-900 rounded-[3rem] p-2 shadow-2xl ring-1 ring-white/10 phone-float">
              <div class="rounded-[2.6rem] overflow-hidden">
                <img src="/screens/home.png" alt="Suslify home feed showing donation listings" class="w-full h-auto block" loading="eager"/>
              </div>
            </div>
            <!-- floating badge -->
            <div class="badge-float-1 absolute -right-4 top-20 bg-white rounded-2xl shadow-lg px-4 py-3 border border-slate-100 text-sm font-semibold text-slate-800 flex items-center gap-2">
              <span class="text-xl">📦</span> New donation posted
            </div>
            <div class="badge-float-2 absolute -left-6 bottom-24 bg-white rounded-2xl shadow-lg px-4 py-3 border border-slate-100 text-sm font-semibold text-slate-800 flex items-center gap-2">
              <span class="text-xl">✅</span> Pickup confirmed!
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── WHERE YOU FIT IN ── -->
  <section id="where-you-fit" class="py-24 bg-slate-50 scroll-mt-16">
    <div class="max-w-5xl mx-auto px-5">
      <div class="text-center mb-10">
        <p class="text-xs font-bold uppercase tracking-widest text-brand-600 mb-3">Get started</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mb-4">Where do you fit in?</h2>
        <p class="text-lg text-slate-500 max-w-xl mx-auto leading-relaxed">
          Suslify works two ways. Pick the one that sounds like you.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {[
          {
            emoji: '📦',
            eyebrow: 'For donors',
            title: 'I have items to give',
            desc: 'Post what you no longer need, choose who receives it, and arrange the handoff in the app.',
            href: '/for-donors',
            cta: 'See how donating works',
          },
          {
            emoji: '🏢',
            eyebrow: 'For non-profits',
            title: 'I need items for my organization',
            desc: 'Post a request board of exactly what you need, and let nearby donors come to you. Free to register.',
            href: '/for-non-profits',
            cta: 'See how it works for non-profits',
          },
        ].map(({ emoji, eyebrow, title, desc, href, cta }) => (
          <a
            href={href}
            class="group bg-white border border-slate-200 rounded-2xl p-7 flex flex-col hover:border-brand-300 hover:shadow-card-hover hover:-translate-y-0.5 transition-all duration-200"
          >
            <div class="w-12 h-12 rounded-2xl bg-brand-50 border border-brand-100 flex items-center justify-center text-2xl mb-4">{emoji}</div>
            <p class="text-xs font-bold uppercase tracking-widest text-brand-600 mb-2">{eyebrow}</p>
            <h3 class="font-bold text-slate-900 text-lg mb-2 leading-snug">{title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed mb-5">{desc}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 text-sm font-bold text-brand-600 group-hover:gap-2.5 transition-all">
              {cta}
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── ALSO INCLUDED ── -->
  <section class="py-16 bg-white border-y border-slate-100">
    <div class="max-w-5xl mx-auto px-5">
      <p class="text-center text-xs font-bold uppercase tracking-widest text-brand-600 mb-10">Also included</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        {extras.map(({ icon, title, desc }) => (
          <div class="text-center sm:text-left">
            <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center mb-3 mx-auto sm:mx-0" set:html={icon} />
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">{title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── BETA SIGNUP FORM ── -->
  <section id="beta" class="py-24 bg-white scroll-mt-20">
    <div class="max-w-2xl mx-auto px-5">

      <div class="text-center mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-600 mb-3">Beta launch</p>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 mb-4">
          Be among the first to use it.
        </h2>
        <p class="text-slate-500 leading-relaxed max-w-md mx-auto">
          Suslify is launching in beta. Sign up now to get early access, free
          for donors and non-profits. No credit card, no commitment.
        </p>
      </div>

      <form
        id="beta-form"
        class="bg-white border border-slate-100 rounded-3xl shadow-card p-8 space-y-5"
        novalidate
      >
        <div>
          <label for="beta-name" class="block text-sm font-semibold text-slate-700 mb-1.5">Full name</label>
          <input
            id="beta-name"
            name="entry.2005620554"
            type="text"
            placeholder="Your name"
            required
            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition"
          />
        </div>

        <div>
          <label for="beta-email" class="block text-sm font-semibold text-slate-700 mb-1.5">Email address</label>
          <input
            id="beta-email"
            name="entry.1045781291"
            type="email"
            placeholder="you@example.com"
            required
            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition"
          />
        </div>

        <div>
          <label for="beta-reason" class="block text-sm font-semibold text-slate-700 mb-1.5">
            Why do you want to join? <span class="font-normal text-slate-400">(optional)</span>
          </label>
          <textarea
            id="beta-reason"
            name="entry.839337160"
            rows="4"
            placeholder="Are you a donor, a non-profit, or just curious? Tell us a little about yourself..."
            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          id="beta-submit"
          class="w-full bg-brand-500 hover:bg-brand-600 active:bg-brand-700 text-white font-semibold py-3.5 rounded-xl transition-all shadow-md shadow-brand-500/20 hover:-translate-y-px text-base"
        >
          Join the Beta. It's Free
        </button>

        <!-- Error message -->
        <p id="beta-error" class="hidden text-center text-sm text-red-500 font-medium"></p>

        <!-- Success message (hidden until submitted) -->
        <div id="beta-success" class="hidden text-center py-4">
          <div class="text-3xl mb-3">🎉</div>
          <p class="font-semibold text-slate-900 mb-1">You're in!</p>
          <p class="text-sm text-slate-500">Check your email for instructions on how to download the app. If you don't see it, check your spam or try again.</p>
        </div>
      </form>

      <!-- Store badges - coming soon -->
      <div class="mt-8 text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4">App coming soon on</p>
        <div class="flex justify-center flex-wrap gap-4">
          <div class="flex flex-col items-center gap-1.5 cursor-not-allowed">
            <div class="flex items-center gap-3 bg-slate-100 text-slate-400 px-5 py-3 rounded-2xl opacity-50 select-none">
              <svg class="w-6 h-6 shrink-0" viewBox="0 0 28 28" fill="none"><path d="M20.3 14.8c0-3.2 2.6-4.7 2.7-4.8-1.5-2.1-3.8-2.4-4.6-2.4-2-.2-3.8 1.2-4.8 1.2-1 0-2.5-1.2-4.2-1.1-2.1 0-4.1 1.2-5.2 3.1-2.2 3.9-.6 9.6 1.6 12.7 1.1 1.5 2.3 3.2 3.9 3.2 1.6-.1 2.2-1 4.1-1 1.9 0 2.5 1 4.2 1 1.7 0 2.8-1.6 3.8-3.1 1.2-1.7 1.7-3.5 1.7-3.6-.1-.1-3.2-1.3-3.2-4.2zm-3-8.1c.9-1.1 1.5-2.6 1.3-4.1-1.3.1-2.8.9-3.7 2-.8.9-1.6 2.4-1.4 3.9 1.4.1 2.9-.7 3.8-1.8z" fill="currentColor"/></svg>
              <span class="text-sm font-semibold">App Store</span>
            </div>
            <span class="text-xs text-slate-400">Coming soon</span>
          </div>
          <div class="flex flex-col items-center gap-1.5 cursor-not-allowed">
            <div class="flex items-center gap-3 bg-slate-100 text-slate-400 px-5 py-3 rounded-2xl opacity-50 select-none">
              <svg class="w-6 h-6 shrink-0" viewBox="0 0 28 28" fill="none"><path d="M4.5 3.3A1.5 1.5 0 0 0 3 4.8v18.4a1.5 1.5 0 0 0 2.3 1.3l14-9.2a1.5 1.5 0 0 0 0-2.6L5.3 3.5a1.5 1.5 0 0 0-.8-.2z" fill="currentColor"/></svg>
              <span class="text-sm font-semibold">Google Play</span>
            </div>
            <span class="text-xs text-slate-400">Coming soon</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <script>
    const ENDPOINT = 'https://script.google.com/macros/s/AKfycbyGkqqkb3584Prj9HjAmV9e4sIa1G0q66PIYwTROF_qlNyd9AS1k8597X8Ns_pVrVJV/exec';

    const form = document.getElementById('beta-form') as HTMLFormElement | null;
    const success = document.getElementById('beta-success');
    const submitBtn = document.getElementById('beta-submit') as HTMLButtonElement | null;
    const errorMsg = document.getElementById('beta-error');

    if (form && success && submitBtn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = (document.getElementById('beta-name') as HTMLInputElement).value.trim();
        const email = (document.getElementById('beta-email') as HTMLInputElement).value.trim();
        const reason = (document.getElementById('beta-reason') as HTMLTextAreaElement).value.trim();
        if (!name || !email) return;

        submitBtn.textContent = 'Sending…';
        submitBtn.disabled = true;
        if (errorMsg) errorMsg.classList.add('hidden');

        try {
          await fetch(ENDPOINT, {
            method: 'POST',
            body: JSON.stringify({ email, name, reason }),
          });
        } catch {
          // expected — no-cors opaque response
        }
        form.querySelectorAll('input, textarea, button').forEach((el) => (el as HTMLElement).classList.add('hidden'));
        success!.classList.remove('hidden');
      });
    }
  </script>

  <!-- ── CONTACT ── -->
  <section id="contact" class="py-24 bg-slate-50">
    <div class="max-w-6xl mx-auto px-5">
      <div class="text-center mb-12">
        <p class="text-xs font-bold uppercase tracking-widest text-brand-600 mb-3">Get in touch</p>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 mb-4">We'd love to hear from you</h2>
        <p class="text-lg text-slate-500 max-w-xl mx-auto leading-relaxed">
          Questions, partnerships, or feedback. Reach out directly.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-2xl mx-auto">
        <div class="bg-white border border-slate-100 rounded-2xl p-7 shadow-card">
          <div class="w-11 h-11 bg-brand-50 rounded-xl flex items-center justify-center mb-4 text-xl">✉️</div>
          <h3 class="font-bold text-slate-900 mb-2">Contact us</h3>
          <p class="text-sm text-slate-500 leading-relaxed mb-5">
            For partnerships, questions, or feedback. We'd love to hear from you.
          </p>
          <div class="flex items-center gap-3">
            <a href="mailto:hello@suslify.com"
               class="inline-flex bg-brand-500 hover:bg-brand-600 text-white font-bold text-sm px-5 py-2.5 rounded-full transition-all shadow-md shadow-brand-500/20">
              hello@suslify.com
            </a>
            <a href="https://linkedin.com/company/suslify" target="_blank" rel="noreferrer"
               class="w-10 h-10 flex items-center justify-center rounded-full border border-slate-200 hover:border-[#0A66C2] hover:bg-[#0A66C2] text-slate-400 hover:text-white transition-all"
               aria-label="Suslify on LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a href="https://www.instagram.com/suslify/" target="_blank" rel="noreferrer"
               class="w-10 h-10 flex items-center justify-center rounded-full border border-slate-200 hover:border-[#E1306C] hover:bg-[#E1306C] text-slate-400 hover:text-white transition-all"
               aria-label="Suslify on Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
              </svg>
            </a>
          </div>
        </div>

        <div class="bg-white border border-slate-100 rounded-2xl p-7 shadow-card">
          <div class="w-11 h-11 bg-brand-50 rounded-xl flex items-center justify-center mb-4 text-xl">💬</div>
          <h3 class="font-bold text-slate-900 mb-2">Share feedback</h3>
          <p class="text-sm text-slate-500 leading-relaxed mb-5">
            Tell us what you'd like to see. Every response is read personally.
          </p>
          <a href="https://forms.gle/zkx2MMfZv3YBTBbZA" target="_blank" rel="noreferrer"
             class="inline-flex border border-slate-200 hover:border-brand-300 text-slate-700 font-bold text-sm px-5 py-2.5 rounded-full transition-all bg-white hover:shadow-md">
            Open feedback form
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ── -->
  <section class="py-12 bg-white">
    <div class="max-w-6xl mx-auto px-5">
      <div class="relative overflow-hidden bg-brand-50 border border-brand-100 rounded-3xl px-8 py-14 text-center">
        <div class="relative">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 mb-3">Start giving today.</h2>
          <p class="text-slate-500 text-lg mb-8 max-w-lg mx-auto leading-relaxed">
            Join donors and non-profits in the Suslify beta and start creating real
            impact, for free.
          </p>
          <a href="#beta"
             class="inline-flex bg-brand-500 hover:bg-brand-600 text-white font-bold px-8 py-4 rounded-full text-base transition-all shadow-lg shadow-brand-500/25 hover:-translate-y-0.5 active:translate-y-0">
            Sign Up for Beta. It's Free
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-14px); }
  }
  @keyframes floatBadge {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-8px); }
  }
  .phone-float { animation: float 5s ease-in-out infinite; }
  .badge-float-1 { animation: floatBadge 5s ease-in-out infinite; animation-delay: -1.5s; }
  .badge-float-2 { animation: floatBadge 5s ease-in-out infinite; animation-delay: -3s; }
</style>
