---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="For Non-profits | Suslify | Free Item Donation Platform for Nonprofits"
  description="Suslify is free for non-profits. Post item requests, receive donations from nearby donors, coordinate pickup through in-app messaging, and track everything received."
>
  <Header activePage="For non-profits" />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-900 pt-20 pb-16 md:pt-28 md:pb-24 text-white">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-24 right-0 w-[600px] h-[600px] rounded-full bg-brand-600/20 blur-3xl"></div>
      <div class="absolute bottom-0 -left-24 w-[400px] h-[400px] rounded-full bg-brand-800/40 blur-3xl"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-5 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-brand-400 mb-4">For non-profits &amp; nonprofits</p>
        <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-6 leading-tight">
          Get the items<br />
          <span class="text-brand-400">your non-profit needs.</span>
        </h1>
        <p class="text-brand-100/80 text-lg leading-relaxed mb-8 max-w-lg">
          Post item requests, request to get a posted item, and manage
          everything in one place. Share events, announcements, volunteer
          opportunities, and more in the community feed — completely free for
          registered non-profits.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/#beta"
             class="inline-flex bg-brand-500 hover:bg-brand-400 text-white font-bold px-7 py-3.5 rounded-full text-base transition-all shadow-lg shadow-brand-500/30 hover:-translate-y-0.5">
            Sign up for beta. It's free
          </a>
          <a href="mailto:hello@suslify.com"
             class="inline-flex border border-white/20 hover:border-white/40 text-white/80 hover:text-white font-bold px-7 py-3.5 rounded-full text-base transition-all">
            Talk to us
          </a>
        </div>
      </div>
      <!-- 2-phone fan -->
      <div class="flex justify-center lg:justify-center">
        <div class="relative mr-8" style="width: 320px; height: 540px;">
          <div class="absolute inset-0 rounded-[3rem] bg-brand-500/25 blur-3xl scale-110 pointer-events-none"></div>
          <!-- back phone: requests list, rotated left -->
          <div class="absolute left-0 top-6" style="transform: rotate(-7deg); transform-origin: bottom center; z-index: 1;">
            <div class="w-44 bg-slate-900 rounded-[2.6rem] p-1.5 shadow-xl ring-1 ring-white/10">
              <div class="rounded-[2.3rem] overflow-hidden">
                <img src="/screens/requests.png" alt="Non-profit requests board" class="w-full h-auto block" loading="eager"/>
              </div>
            </div>
          </div>
          <!-- front phone: offer-item (donor offering to a request), rotated right -->
          <div class="absolute right-0 top-0" style="transform: rotate(5deg); transform-origin: bottom center; z-index: 2;">
            <div class="w-44 bg-slate-900 rounded-[2.6rem] p-1.5 shadow-2xl ring-1 ring-white/10">
              <div class="rounded-[2.3rem] overflow-hidden">
                <img src="/screens/offer-item.png" alt="Donor offering an item to a non-profit request" class="w-full h-auto block" loading="eager"/>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What non-profits get -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-5">
      <div class="text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 mb-4">What your non-profit gets</h2>
        <p class="text-slate-500 text-lg max-w-xl mx-auto">Free tools built for the needs of real nonprofits.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          {
            icon: '📋',
            title: 'Organization profile',
            desc: 'A public page for your non-profit where donors can browse your active requests and learn about your mission.',
          },
          {
            icon: '📦',
            title: 'Item requests',
            desc: 'Post a request for items your organization needs. Browse posted donations from donors and request them directly. Donors nearby can also match items to your open requests.',
          },
          {
            icon: '💬',
            title: 'Direct messaging',
            desc: 'Communicate with donors directly inside the app to coordinate pickups without exchanging personal contact info.',
          },
          {
            icon: '📣',
            title: 'Community feed',
            desc: 'Post announcements, share upcoming events, highlight volunteer opportunities, and link to external fundraisers. Keep supporters informed and engaged in one place.',
          },
          {
            icon: '📊',
            title: 'Donation history',
            desc: 'A full log of every item received: what was donated, when, and by whom. Simple record-keeping built in.',
          },
          {
            icon: '💚',
            title: 'Always free',
            desc: 'Suslify is free for non-profits. No subscriptions, no listing fees, no commissions.',
          },
        ].map(({ icon, title, desc }) => (
          <div class="bg-white border border-slate-100 rounded-2xl p-6 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 transition-all">
            <div class="w-11 h-11 bg-brand-50 rounded-xl flex items-center justify-center mb-4 text-xl">{icon}</div>
            <h3 class="font-bold text-slate-900 mb-2">{title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works for non-profits -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-4xl mx-auto px-5">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 mb-4">Getting started for non-profits</h2>
        <p class="text-slate-500 text-lg">Up and running in minutes.</p>
      </div>
      <ol class="space-y-5">
        {[
          { n: '1', title: 'Register your non-profit', desc: 'Create a free account and set up your organization\'s profile. Add your mission, location, and what types of items you typically need.' },
          { n: '2', title: 'Post item requests', desc: 'List the items your non-profit needs: furniture, clothing, kitchen supplies, anything. Add as many requests as you need with quantities and conditions.' },
          { n: '3', title: 'Browse and request posted items', desc: 'Scroll through items posted by donors and request the ones your organisation needs, or wait for donors with matching items to reach out directly.' },
          { n: '4', title: 'Coordinate pickup in-app', desc: 'Message donors directly to arrange pickup or drop-off. No phone numbers shared, all communication stays in the app. Accept or decline incoming donation requests, then set up a pickup arrangement, all in one place.' },
          { n: '5', title: 'Track what you receive', desc: 'Every confirmed donation logs to your history. Know exactly what came in, when, and from whom.' },
        ].map(({ n, title, desc }, i, arr) => (
          <li class="flex gap-5 relative">
            {i < arr.length - 1 && <div class="absolute left-5 top-12 bottom-0 w-px bg-brand-100"></div>}
            <div class="w-10 h-10 rounded-full bg-brand-500 text-white font-black text-sm flex items-center justify-center shrink-0 shadow-md shadow-brand-500/30 z-10">{n}</div>
            <div class="pb-6">
              <h3 class="font-bold text-slate-900 mb-1">{title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 bg-white">
    <div class="max-w-6xl mx-auto px-5">
      <div class="bg-gradient-to-br from-brand-900 to-brand-700 rounded-3xl p-10 text-white text-center shadow-2xl">
        <h2 class="text-3xl font-black tracking-tight mb-3">Register your non-profit and join the beta today</h2>
        <p class="text-white/70 mb-7 max-w-md mx-auto">
          It's free, takes minutes, and puts you in front of donors in your community.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/#beta" class="inline-flex bg-brand-500 hover:bg-brand-400 text-white font-bold px-7 py-3.5 rounded-full text-base hover:-translate-y-0.5 transition-all shadow-lg">
            Join the Beta. It's Free
          </a>
          <a href="mailto:hello@suslify.com" class="inline-flex border border-white/20 hover:border-white/40 text-white/80 hover:text-white font-bold px-7 py-3.5 rounded-full text-base transition-all">
            Contact us
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
