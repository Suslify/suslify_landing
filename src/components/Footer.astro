---
const year = new Date().getFullYear();
---

<footer class="bg-brand-950 text-white/80 pt-16 pb-8 mt-16">
  <div class="max-w-6xl mx-auto px-5">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 pb-12 border-b border-white/10">

      <!-- Brand -->
      <div class="text-left">
        <a href="/" class="flex items-center gap-2.5 mb-4">
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 shrink-0">
            <rect width="200" height="200" rx="48" fill="#3DBE8B"/>
            <path d="M40 172 A44 44 0 0 1 84 128"   stroke="white" stroke-width="12" fill="none" stroke-linecap="round"/>
            <path d="M40 172 A80 80 0 0 1 120 92"   stroke="white" stroke-width="12" fill="none" stroke-linecap="round" opacity="0.6"/>
            <path d="M40 172 A116 116 0 0 1 156 56" stroke="white" stroke-width="12" fill="none" stroke-linecap="round" opacity="0.28"/>
            <circle cx="40" cy="172" r="14" fill="white"/>
          </svg>
          <span class="font-medium text-base text-white">Suslify</span>
        </a>
        <p class="text-sm leading-relaxed text-white/60 max-w-xs">
          Helping people donate items they no longer need to non-profits and
          people who do. Free for everyone.
        </p>
      </div>

      <!-- Product links -->
      <div class="text-left">
        <p class="text-xs font-bold uppercase tracking-widest text-white/40 mb-4">Product</p>
        <ul class="space-y-3 text-sm">
          <li><a href="/"              class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/for-donors"    class="hover:text-white transition-colors">For donors</a></li>
          <li><a href="/for-non-profits" class="hover:text-white transition-colors">For non-profits</a></li>
          <li><a href="/#beta"         class="hover:text-white transition-colors">Join the beta</a></li>
        </ul>
      </div>

      <!-- Company links -->
      <div class="text-left">
        <p class="text-xs font-bold uppercase tracking-widest text-white/40 mb-4">Company</p>
        <ul class="space-y-3 text-sm">
          <li><a href="/about"    class="hover:text-white transition-colors">About</a></li>
          <li><a href="/faq"      class="hover:text-white transition-colors">FAQ</a></li>
          <li><a href="/#contact" class="hover:text-white transition-colors">Contact</a></li>
          <li>
            <a href="https://www.linkedin.com/company/suslify/" target="_blank" rel="noreferrer"
               class="hover:text-white transition-colors">LinkedIn</a>
          </li>
          <li>
            <a href="https://www.instagram.com/suslify/" target="_blank" rel="noreferrer"
               class="hover:text-white transition-colors">Instagram</a>
          </li>
          <li>
            <a href="https://forms.gle/zkx2MMfZv3YBTBbZA" target="_blank" rel="noreferrer"
               class="hover:text-white transition-colors">Feedback</a>
          </li>
          <li><a href="/privacy"  class="hover:text-white transition-colors">Privacy policy</a></li>
          <li><a href="/terms"    class="hover:text-white transition-colors">Terms of use</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/35">
      <p>© {year} Suslify. All rights reserved.</p>
      <p>
        Questions? <a href="mailto:hello@suslify.com" class="underline hover:text-white/60 transition-colors">hello@suslify.com</a>
      </p>
    </div>

  </div>
</footer>
